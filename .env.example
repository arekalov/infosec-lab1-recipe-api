# Скопируйте в .env и подставьте собственные значения.
# Файл .env в репозиторий не попадает (см. .gitignore).

# Ключ подписи JWT: Base64, минимум 32 байта после декодирования.
# Сгенерировать:  openssl rand -base64 32
JWT_SECRET=

# Пароль пользователя БД. Для локального H2 можно оставить пустым.
DB_PASSWORD=
